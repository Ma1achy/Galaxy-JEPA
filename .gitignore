# Data / artefacts (never commit cutouts, catalogues, checkpoints).
# Anchored to the repo root so the source package src/galaxy_jepa/data/ is NOT ignored.
/data/
/datasets/
/.sciserver_work/
checkpoints/
runs/
# ...and the same three as *symlinks*: the corpora, runs and pull staging live on an external
# SSD (the internal disk is 460 GB), and a trailing-slash pattern matches a directory only, so
# without these the links themselves would be committed.
/data
/runs
/.sciserver_work
wandb/

# Generated test fixtures (the seeded generator is committed, its output is not).
tests/fixtures/synthetic/
*.parquet
*.ckpt
*.pt

# Design-spec delivery archives (the extracted docs/ files are what's tracked).
galjep.zip

# OS / editor
.DS_Store
.idea/
.vscode/
.env
